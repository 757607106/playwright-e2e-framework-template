# Optional target application. The included demo runs locally without this value.
BASE_URL=http://localhost:3000
REPORT_ENV=local
TEST_WORKERS=1
TEST_TIMEOUT=30000
EXPECT_TIMEOUT=10000
HEADLESS=true
PLAYWRIGHT_TRACE=retain-on-failure
PLAYWRIGHT_SCREENSHOT=only-on-failure
PLAYWRIGHT_VIDEO=retain-on-failure
REPORT_HISTORY_LIMIT=20
# Disable bundled localhost examples after connecting your own application.
E2E_SKIP_EXAMPLES=false
EXAMPLE_PORT=4173
# Set true only after independent accounts and server-side data isolation exist.
E2E_ISOLATED_WORKERS=false

# Shared model connection. Independent preparation opts in with --mode llm.
MODEL_NAME=
API_BASE_URL=
API_KEY=
# Built-ins: openai-compatible, openai, anthropic, google. Custom adapters: model.config.ts.
MODEL_PROVIDER=openai-compatible
# Blank selects the provider's default protocol. See docs/configuration.md.
MODEL_PROTOCOL=
# schema (JSON Schema), json (JSON mode), text (parse and validate locally).
MODEL_OUTPUT_MODE=schema
# Freeze and provision this batch before application regression (ID printed by data:generate).
DATASET_ID=
